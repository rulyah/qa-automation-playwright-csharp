<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>false</Headless>
      <SlowMo>700</SlowMo>
    </LaunchOptions>
  </Playwright>

  <!-- один воркер, щоб вікна не відкривались паралельно і за ними було видно, що відбувається -->
  <NUnit>
    <NumberOfTestWorkers>1</NumberOfTestWorkers>
  </NUnit>

</RunSettings>
